# ============================================
# RU Coach - Variables de Entorno
# ============================================
# Copia este archivo a .env.local y completa los valores

# Supabase (requerido - soporta tanto las nuevas llaves Publishable/Secret como las legacy Anon/Service Role)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
# Alternativa legacy (opcional si usas las de arriba):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Codigo de activacion para primer admin (requerido en produccion)
# IMPORTANTE: Usa un codigo unico y seguro. No exponer en cliente.
# Solo se valida en el servidor.
ADMIN_SETUP_CODE=RUCOACH2026

# Resend - Correos transaccionales (opcional pero recomendado en produccion)
# Sin esto, los codigos de invitacion NO se envian por correo (solo se muestran en pantalla)
# Obtén tu API key en https://resend.com/api-keys
# Verifica tu dominio en https://resend.com/domains para enviar desde tu dominio
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=RU Coach <noreply@tudominio.com>

# URL base de la app (para enlaces en correos y recuperacion de contraseña)
# En Vercel se infiere automaticamente. En local usa http://localhost:3000
# IMPORTANTE: Añade en Supabase Dashboard > Auth > URL Configuration:
# - Site URL: tu URL de produccion
# - Redirect URLs: http://localhost:3000/auth/callback, https://tu-app.vercel.app/auth/callback
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# Opcional: zona horaria para cálculos de logros (por defecto la del servidor). Útil en tests locales.
# ACHIEVEMENTS_EARLY_TZ=America/Argentina/Buenos_Aires
# NEXT_PUBLIC_ACHIEVEMENTS_EARLY_TZ=America/Argentina/Buenos_Aires

# ============================================
# Cloudflare R2 - Almacenamiento de Fotos
# ============================================
# Requerido para fotos de progreso de clientes y avatares (si se usa R2).
# Crea un bucket en Cloudflare R2 y obtén tus credenciales S3 API.
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key
R2_SECRET_ACCESS_KEY=tu-secret-key
R2_BUCKET_NAME=gymcoaching-exercises
# URL pública de acceso (vía dominio personalizado o r2.dev público)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# ============================================
# Web Push Notifications (VAPID)
# ============================================
# Genera tus llaves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
